rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Secure UID-based Admin Authorization:
    // Admin access is granted ONLY based on Firestore admins/{uid} document,
    // or the supported primary Admin UID "7N820XwPYZWjjqbQBjh5V9qeiNt1".
    // No email address is used for authorization.
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.uid == "7N820XwPYZWjjqbQBjh5V9qeiNt1"
      );
    }

    // Check if user is active (not suspended by Administrator)
    function isNotSuspended(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) ||
             get(/databases/$(database)/documents/users/$(userId)).data.get('status', 'active') != 'suspended';
    }

    // Admins collection for role-based authorization
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Profile & Company Settings Document
    // Path: /users/{userId}
    match /users/{userId} {
      // Individual document get: owner access allowed only if account is NOT suspended; Admin has full access
      allow get: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();

      // Collection query / listing: ONLY Admin can query and list the entire users collection
      allow list: if isAdmin();

      // Normal owner update/create allowed only if account is NOT suspended; Admin has full access
      allow write: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
      
      // Invoices Subcollection
      match /invoices/{invoiceId} {
        allow get, list: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
        allow write: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
      }

      // Workspaces Subcollection
      match /workspaces/{workspaceId} {
        allow get, list: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
        allow write: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
      }

      // Customers Subcollection
      match /customers/{customerId} {
        allow get, list: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
        allow write: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
      }

      // Services Subcollection
      match /services/{serviceId} {
        allow get, list: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
        allow write: if (isOwner(userId) && isNotSuspended(userId)) || isAdmin();
      }
    }
  }
}
